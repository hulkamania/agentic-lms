# Moodle Docker Compose Setup
# Copy .env.example to .env and fill in your secrets

# Database Configuration
MOODLE_DATABASE_TYPE=mariadb
MOODLE_DATABASE_HOST=mariadb
MOODLE_DATABASE_PORT=3306
MOODLE_DATABASE_NAME=${MOODLE_DB_NAME:-moodle}
MOODLE_DATABASE_USER=${MOODLE_DB_USER:-moodle}
MOODLE_DATABASE_PASSWORD=${MOODLE_DB_PASSWORD:-changeme-strong-db-pass}

# Moodle Admin
MOODLE_ADMIN_USER=${MOODLE_ADMIN_USER:-admin}
MOODLE_ADMIN_PASSWORD=${MOODLE_ADMIN_PASSWORD:-changeme-strong-admin-pass}
MOODLE_ADMIN_EMAIL=${MOODLE_ADMIN_EMAIL:-admin@example.com}

# Moodle Site
MOODLE_SITE_NAME=${MOODLE_SITE_NAME:-Agentic LMS}
MOODLE_HOST=${MOODLE_HOST:-localhost}
MOODLE_PORT=${MOODLE_PORT:-8080}

# Student Account
MOODLE_STUDENT_USER=${MOODLE_STUDENT_USER:-student}
MOODLE_STUDENT_PASSWORD=${MOODLE_STUDENT_PASSWORD:-changeme-student-pass}
MOODLE_STUDENT_EMAIL=${MOODLE_STUDENT_EMAIL:-student@example.com}

# MariaDB Root
MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD:-changeme-strong-root-pass}

# Moodle Data Paths
MOODLE_DATA_DIR=/bitnami/moodle
MOODLEMOOD_DATA_DIR=/bitnami/moodledata
